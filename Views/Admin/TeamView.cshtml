@model List<GarhwalBhawan.Models.TeamTbl>

<link href="@Url.Content("~/Content/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
<script src="@Url.Content("~/Scripts/jquery-ui.min.js")" type="text/javascript"></script>

@{
    ViewBag.Title = "Team List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    <style type="text/css">
        .grid {
            width: 100%;
        }
    </style>
}

<div class="container">
    <div style="padding:7px 0;">
        <input id="AddTeam" type="button" value="Add New Member" />
    </div>

    <div id='OpenDilog'></div>

    <h2>Team Information List</h2>

    <div class="container">
        @{
            WebGrid grid = new WebGrid(Model);
            @grid.GetHtml(
                   tableStyle: "table table-hover",
         fillEmptyRows: false,
         mode: WebGridPagerModes.All,
         firstText: "<< First",
         previousText: "< Prev",
         nextText: "Next >",
         lastText: "Last >>",
         columns: new[] {
         grid.Column("ID",header: "ID"),
         grid.Column(header: "Image", format: @<text><img src="~/Image/Cabinet/@item.Image" id="@item.ID" style="width:100px; height:100px"></text>),
         grid.Column("Name",header: "Name"),
         grid.Column("Alt",header: "Alt"),
         grid.Column("Description",header: "Description"),
         grid.Column("Rank",header: "Rank"),
         grid.Column("ID", header: "Action", canSort:false,

         format: @<text>
            @Html.Raw("<img src='/images/edit.png' title='Edit' onclick='EditTeam(" + item.ID + ")' />")
            @Html.Raw("<img src='/images/delete.png' title='Delete' onclick='DeleteTeam(" + item.ID + ")' />")
        </text>
        )
     })
        }
    </div>
</div>


@section Scripts {


    <script type="text/javascript">

        $(document).ready(function () {
            $('#AddTeam').click(function () {
                var div = $("#OpenDilog");
                div.load("/Admin/TeamCreate", function () {
                    div.dialog({
                        modal: true,
                        width: 500,
                        height: 500,
                        title: "Add New Team Member",
                        resizable: false
                    });
                });
            });
        });


        function EditTeam(I_ID) {
            var ph = $("#OpenDilog");
            ph.load("/Admin/TeamEdit?TmID=" + I_ID, function () {
                ph.dialog({
                    modal: true,
                    width: 500,
                    height: 600,
                    title: "Edit Team Member",
                    resizable: false
                });
            });
        }

        function DeleteTeam(I_ID) {
            if (confirm("Are You Sure Delete Selected Member Record No.? " + I_ID)) {
                var data = { 'TmID': I_ID }
                $.post('/Admin/TeamDelete', data,
                function (data) {
                    if (data == true)
                        window.location.href = 'TeamView';
                    else
                        alert("Can't Delete. Contact Support Team.");
                });
            }
        }
    </script>
}

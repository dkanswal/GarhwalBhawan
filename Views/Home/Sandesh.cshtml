@model GarhwalBhawan.Models.TeamTbl

<link href="@Url.Content("~/Content/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
<script src="@Url.Content("~/Scripts/jquery-ui.min.js")" type="text/javascript"></script>


<fieldset class="text-center">
    <legend></legend>

    <div class="display-field heading">
        @Html.DisplayFor(model => model.Name)
    </div>
        <br /><br />

    <div class="display-field container">
        <img src="~/Image/Cabinet/@Model.Image" alt="@Model.Alt" class="img-thumbnail img-responsive" style="height:200px" />
    </div>
        <br /><br />
    <div class="display-field" style="text-align:justify">
        @Html.DisplayFor(model => model.Description)
    </div>
    
</fieldset>

@model IEnumerable<GarhwalBhawan.Models.DisasterTbl>

@{
    ViewBag.Title = "DisasterView";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="container">

    <h2>Disaster List</h2>

    <p style="margin-top:20px">
        @Html.ActionLink("Create New", "DisasterCreate", "Admin", new { @class = "btn btn-info", @style = "text-decoration:none" })
    </p>

    <table class="table table-responsive table-hover">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Heading)
            </th>
           <th>
               @Html.DisplayNameFor(model => model.Body)
           </th>
            <th>
                Action
            </th>
        </tr>

        @foreach (var item in Model)
        {
            using (Html.BeginForm("DisasterDelete", "Admin", new { id = item.ID }))
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Heading)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Body)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "DisasterEdit", new { id = item.ID }) |
                        <button class="glyphicon" type="submit" value="Delete" onclick="return confirm('Are you sure you want to delete @item.ID ') ">
                            <i class="glyphicon glyphicon-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        }

    </table>
</div>
@model List<GarhwalBhawan.Models.ImageTbl>

<link href="@Url.Content("~/Content/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
<script src="@Url.Content("~/Scripts/jquery-ui.min.js")" type="text/javascript"></script>

@{
    ViewBag.Title = "Image List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    <style type="text/css">
        .grid {
            width: 100%;
        }
    </style>
}

<div class="container">
    <div style="padding:7px 0;">
        <table>
            <tr>
                <td>
                    <input id="AddImage" type="button" value="Add New Image" />
                </td>
                <td>
                    <input id="BulkImageDelete" type="button" value="Delete Bulk Image" />
                </td>
                <td>
                    <a href="~/Admin/SearchImage">Search</a>
                </td>
                <td>
                    <a href="~/Admin/MultiImageUpload" target="_blank">Upload MultiPle Images</a>
                </td>
            </tr>
        </table>
    </div>
    
    <div id='OpenDilog'></div>

    <h2>Image Information List</h2>

    <div class="container">
        @{
            WebGrid grid = new WebGrid(Model);
            @grid.GetHtml(
                   tableStyle: "table table-hover",
         fillEmptyRows: false,
         mode: WebGridPagerModes.All,
         firstText: "<< First",
         previousText: "< Prev",
         nextText: "Next >",
         lastText: "Last >>",
         columns: new[] {
         grid.Column(header:"Select",  format:@<text> <input id="chkSelect" type="checkbox" class="chkSelect" value="@item.ID" /></text>),
         grid.Column("ID",header: "ID"),
         grid.Column(header: "Image", format: @<text><img src="~/Image/@item.Image" id="@item.ID" style="width:100px; height:100px"></text>),
         grid.Column("Alt",header: "Alt"),
         grid.Column("ImgGroup",header: "ImgGroup"),
         grid.Column("Date",header: "Date"),
         grid.Column("Year",header: "Year"),
         grid.Column("Description",header: "Description"),
         grid.Column("ID", header: "Action", canSort:false,

         format: @<text>
            @Html.Raw("<img src='/images/edit.png' title='Edit' onclick='EditImage(" + item.ID + ")' />")
            @Html.Raw("<img src='/images/delete.png' title='Delete' onclick='DeleteImage(" + item.ID + ")' />")
        </text>
        )
     })
        }
    </div>
</div>

<script src="~/js/ImageView.js"></script>
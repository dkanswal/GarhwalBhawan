@model IEnumerable<GarhwalBhawan.Models.SamacharTbl>

@{
    ViewBag.Title = "SamacharView";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="container">

    <h2>Samachar List</h2>

    <p style="margin-top:20px">
        @Html.ActionLink("Create New", "SamacharCreate", "Admin", new { @class = "btn btn-info", @style = "text-decoration:none" })
    </p>

    <table class="table table-responsive table-hover">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Heading)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Alt)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            using (Html.BeginForm("SamacharDelete", "Admin", new { id = item.ID }))
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Heading)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td>
                        <img src="~/Image/News/@item.Image" alt="@item.Alt" style="height:50px; width:50px" />
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Alt)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "SamacharEdit", new { id = item.ID }) |
                        <button class="glyphicon" type="submit" value="Delete" onclick="return confirm('Are you sure you want to delete @item.ID ') ">
                            <i class="glyphicon glyphicon-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        }

    </table>
</div>
    <!-- start-smoth-scrolling -->
    <!--animate-->
    <script>
        new WOW().init();
    </script>
    <!--end animate-->

    <script type="text/javascript">
        $(document).ready(function () {
            //$('#side-navbar li').each(function () {
            //    $(this).css('background-color', 'red');
            //    $(this).css('border-bottom', '1px solid black');
            //});
            $('#implink a').each(function () {
                $(this).css('color', '#7697A2');
                $(this).css('font-weight', 'bold');
            });

            $('.navbar a').each(function () {
                $(this).css('color', '#fff');
                $(this).css('padding-left', '50px');
                $(this).css('background-color', 'red');
            });
        });
    </script>

</head>
<body>

    <nav class="navbar navbar-default navbar-fixed-top header-nav wow fadeInDown animated " style="background-color:red;">
        <div class="container-fluid">
            <!-- Brand and toggle get grouped for better mobile display -->
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                <a class="navbar-brand" href="~/Home/Index" style="font-size:19px; font-weight:bolder;">
                    गढ़वाल हितेषिणी सभा (पंजी)
                </a>

                @*<a class="navbar-brand link link--yaku" href="~/Home/Index" style="font-size:25px; font-weight:bolder;">
                        <span>ग</span><span>ढ़</span><span>वा</span><span>ल</span>
                        <span>हि</span><span>तै</span><span>षि</span><span>णी</span>
                        <span>स</span><span>भा</span><span>(</span><span>पं</span><span>जी</span><span>.</span><span>)</span>
                    </a>*@

            </div>

            <!-- Collect the nav links, forms, and other content for toggling -->
            <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
                <ul class="nav navbar-nav navbar-right">
                    <li class="active">
                        @Html.ActionLink("मुख्य पृष्ठ", "Index", "home", new { @class = "hvr-overline-from-left button2" })
                    </li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">गढ़वाल हितैषिणी सभा <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li>
                                @Html.ActionLink("एक परिचय", "EkParichay", "home")
                                @*@Html.ActionLink("एक परिचय", "DownloadFile", "home", new { @id = "_Hiteshani Sabha" }, new { target = "_blank" })*@
                            </li>
                            <li>
                                @Html.ActionLink("उद्देश्य", "Purpose", "home")
                            </li>
                            <li>
                                @Html.ActionLink("वर्त्तमान कार्यकारिणी", "present-executive", "home")
                            </li>
                            <li>
                                @Html.ActionLink("पूर्व कार्यकारिणी", "DownloadFile", "home", new { @id = 9 }, new { target = "_blank" })
                            </li>
                            <li>
                                @Html.ActionLink("सभा की सदस्य सूची", "DownloadFile", "home", new { @id = 16 }, new { target = "_blank" })
                            </li>
                        </ul>
                    </li>

                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">गढ़वाल भवन <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li>
                                @Html.ActionLink("भवन का इतिहास", "BhawanHistory", "Home")
                                @*<a href="~/Document/GadhwalBhawan.pdf" target="_blank">भवन का इतिहास</a>*@
                            </li>
                            <li>
                                <a href="#">गढ़वाल भवन परिसर <i class="glyphicon glyphicon-chevron-right"></i></a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                @Html.ActionLink("भागीरथी हाल", "Hall", "home", new { @id = "Bhagirathi" }, new { target = "_blank" })
                            </li>
                            <li>
                                @Html.ActionLink("अलकनन्दा हाल", "Hall", "home", new { @id = "Alaknanda" }, new { target = "_blank" })
                            </li>
                            <li>
                                @Html.ActionLink("भवन कार्यालय", "Hall", "home", new { @id = "Karyalya" }, new { target = "_blank" })
                            </li>
                            <li>
                                @Html.ActionLink("सभा कक्ष", "Hall", "home", new { @id = "SabhaKaksh" }, new { target = "_blank" })
                            </li>
                            <li>
                                @Html.ActionLink("यात्री निवास", "Hall", "home", new { @id = "YatriNiwas" }, new { target = "_blank" })
                            </li>
                        </ul>
                    </li>

                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">सामाजिक पहल <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li>
                                @Html.ActionLink("उत्तराखंड आपदा सहयोग", "support-uttarakhand-disaster", "home")
                            </li>
                            <li>
                                @Html.ActionLink("विद्यार्थियों को प्रोत्साहन", "Vidyarthi", "home")
                            </li>
                            <li>
                                @Html.ActionLink("सामाजिक सहयोग", "samajik-sahyog", "home")
                            </li>
                        </ul>
                    </li>

                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">गैलरी<span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li>
                                @Html.ActionLink("फोटो गैलरी", "PhotoGallery", "home")
                            </li>
                            <li>
                                @Html.ActionLink("video गैलरी", "VideoGallery", "home")
                            </li>
                        </ul>
                    </li>

                    <li>
                        @Html.ActionLink("संपर्क करें", "Contact", "home", new { @class = "hvr-overline-from-left button2" })
                    </li>


                </ul>
            </div><!-- /.navbar-collapse -->
        </div><!-- /.container-fluid -->
    </nav>

    <div class="clearfix"></div>
    
    <!--Fixed Box-->
    <div class="contleftTop">
        <div class="clearfix"></div>
        <a href="~/Home/Index" target="_blank">
            <img src="~/images/logo.png" alt="Garhwal Bhawan Delhi" style="height:50px; width:50px; margin-top:50px" />
        </a>

    </div>

    <div id="body">
        @RenderSection("featured", required: false)
        @RenderBody()
    </div>

    <!-- contact -->
    <div class="contact" style="background-color:#002633">
        <div class="container">
            <div class="col-md-4 contact-left wow fadeInRight animated" data-wow-delay=".5s">
                <h3>संपर्क करें</h3>
                <h2>
                    <img src="~/images/logo.png" alt="Garhwal Bhawan Delhi" style="height:50px; width:50px" />
                    गढ़वाल हितैषिणी सभा (रजिस्टर्ड)
                </h2>
                <p>
                    वीर चन्द्र सिंह गढ़वाली चौक, पचकुयियाँ रोड<br>
                    नई दिल्ली 110001<br>
                    <i class="glyphicon glyphicon-phone"></i> : +91-858887355<br>
                    <i class="glyphicon glyphicon-envelope"></i> :
                    <a href="mailto:garhwalhiteshinisabha@gmail.com" style="color:#fff">garhwalhiteshinisabha@gmail.com</a>
                </p>
                <div class="clearfix"></div>
            </div>
            <div id="implink" class="col-md-5 contact-left wow fadeInUp animated" data-wow-delay=".5s">
                <h3>महत्वपूर्ण लिंक</h3>
                <ul>
                    <li>
                        <a href="http://uk.gov.in/" class="hvr-overline-from-left" target="_blank">Uttarakhand Official</a>
                    </li>
                    <li>
                        <a href="http://uttarakhand.20govt.com/" class="hvr-overline-from-left" target="_blank">Uttarakhand Job</a>
                    </li>
                    <li>
                        <a href="http://www.amarujala.com/uttarakhand" class="hvr-overline-from-left" target="_blank">Uttarakhand News</a>
                    </li>
                    <li>
                        <a href="http://UTCOnline.UK.Gov.in" class="hvr-overline-from-left" target="_blank">UTC Online</a>
                    </li>
                    <li>
                        <a href="http://Uttarakhandtourism.gov.in" class="hvr-overline-from-left" target="_blank">Uttarakhand Tourism</a>
                    </li>
                    <li>
                        <a href="http://uttarakhandmusic.blogspot.in/" class="hvr-overline-from-left" target="_blank">Uttarakhand Songs</a>
                    </li>
                    <li>
                        <a href="http://himalayannews.com/" class="hvr-overline-from-left" target="_blank">Himalayan News</a>
                    </li>

                </ul>

            </div>
            <div class="col-md-3 contact-left footer-bottom wow fadeInLeft animated" data-wow-delay=".5s">

                <h3>
                    लाइक या शेयर करें
                </h3>

                <a href="#"><span>Twitter</span></a>
                <a href="https://www.facebook.com/people/Garhwal-Bhawan-Delhi/100009653312671" target="_blank"><span>Facebook</span></a>
                <a href="#"><span>Pinterest</span></a>
                <a href="#"><span>LinkedIn</span></a>

                <br />

                <p style="color:white">
                    <b>Visiting User :</b> <b> @ApplicationInstance.Application["Totaluser"] </b>
                </p>
            </div>

            <div class="clearfix"></div>
        </div>
    </div>
    <div class="footer wow fadeInDown animated" data-wow-delay=".5s" style="background-color:#c81010">
        <div class="container">
            <p> &copy; 2014 - @DateTime.Now.Year गढ़वाल हितैषिणी सभा (पंजी.)</p>
        </div>
    </div>
    <!-- //contact -->
    <!-- smooth scrolling -->
    <script type="text/javascript">
        $(document).ready(function () {
            var defaults = {
                containerID: 'toTop', // fading element id
                containerHoverID: 'toTopHover', // fading element hover id
                scrollSpeed: 1200,
                easingType: 'linear'
            };
            $().UItoTop({ easingType: 'easeOutQuart' });
        });
    </script>
    <!-- //smooth scrolling -->
    <a href="#" id="toTop" style="display: block;"> <span id="toTopHover" style="opacity: 1;"> </span></a>


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>

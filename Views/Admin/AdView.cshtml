@model List<GarhwalBhawan.Models.AdTbl>

<link href="@Url.Content("~/Content/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
<script src="@Url.Content("~/Scripts/jquery-ui.min.js")" type="text/javascript"></script>

@{
    ViewBag.Title = "Ad List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    <style type="text/css">
        .grid {
            width: 100%;
        }
    </style>
}

<div class="container">
    <div style="padding:7px 0;">
        <input id="AddAd" type="button" value="Add New Advertisement" />
    </div>

    <div id='OpenDilog'></div>

    <h2>Ad Information List</h2>

    <div class="container">
        @{
            WebGrid grid = new WebGrid(Model);
            @grid.GetHtml(
                   tableStyle: "table table-hover",
         fillEmptyRows: false,
         mode: WebGridPagerModes.All,
         firstText: "<< First",
         previousText: "< Prev",
         nextText: "Next >",
         lastText: "Last >>",
         columns: new[] {
         grid.Column("ID",header: "ID"),
         grid.Column(header: "Image", format: @<text><img src="~/Image/AdImg/@item.Image" alt="@item.Name" id="@item.ID" style="width:100px; height:100px"></text>),
         grid.Column("Name",header: "Name"),
         grid.Column("StartDate",header: "Start Date",format: item => ((item.StartDate == null) ? "" : item.StartDate.ToString("dd-MMM-yyyy"))),
         grid.Column("EndDate",header: "End Date",format: item => ((item.EndDate == null) ? "" : item.EndDate.ToString("dd-MMM-yyyy"))),
         grid.Column("Link",header: "Link"),
         grid.Column("Status",header: "Active/Expired"),
         grid.Column("Amount",header: "Amount Paid"),
         grid.Column("ID", header: "Action", canSort:false,

         format: @<text>
            @Html.Raw("<img src='/images/edit.png' title='Edit' onclick='EditAd(" + item.ID + ")' />")
            @Html.Raw("<img src='/images/delete.png' title='Delete' onclick='DeleteAd(" + item.ID + ")' />")
        </text>
        )
     })
        }
    </div>
</div>


@section Scripts {


    <script type="text/javascript">

        $(document).ready(function () {
            $('#AddAd').click(function () {
                var div = $("#OpenDilog");
                div.load("/Admin/AdCreate", function () {
                    div.dialog({
                        modal: true,
                        width: 500,
                        height: 550,
                        title: "Add New Ad",
                        resizable: false
                    });
                });
            });
        });


        function EditAd(I_ID) {
            var ph = $("#OpenDilog");
            ph.load("/Admin/AdEdit?AdID=" + I_ID, function () {
                ph.dialog({
                    modal: true,
                    width: 500,
                    height: 550,
                    title: "Edit Ad",
                    resizable: false
                });
            });
        }

        function DeleteAd(I_ID) {
            if (confirm("Are You Sure Delete Selected Ad Record No.? " + I_ID)) {
                var data = { 'AdID': I_ID }
                $.post('/Admin/AdDelete', data,
                function (data) {
                    if (data == true)
                        window.location.href = 'AdView';
                    else
                        alert("Can't Delete. Contact Support Team.");
                });
            }
        }
    </script>
}




<!-- contact -->

<script>
    var myVar = setInterval(function () { myTimer() }, 1000);

    function myTimer() {
        var d = new Date();
        var t = d.toLocaleTimeString();
        document.getElementById("demo").innerHTML = d;
    }
</script>
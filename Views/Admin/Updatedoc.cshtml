@model GarhwalBhawan.Models.DocTbl

@{
    ViewBag.Title = "Updatedoc";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">

    <h2>Updatedoc</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)

        <fieldset>
            <legend>DocTbl</legend>

            @Html.HiddenFor(model => model.Id)

            <div class="editor-label">
                @Html.LabelFor(model => model.Name)
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Name)
                @Html.ValidationMessageFor(model => model.Name)
            </div>

            <div class="editor-label">
                @Html.LabelFor(model => model.DocPath)
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.DocPath)
                <input id="FileUpload" title="Upload a File" type="file" name="file" class="btn btn-info" />
            </div>

            <p>
                <input type="submit" value="Save" />
            </p>
        </fieldset>
    }

    <div>
        @Html.ActionLink("Back to List", "DocList")
    </div>

</div>

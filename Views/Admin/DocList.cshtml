@model IEnumerable<GarhwalBhawan.Models.DocTbl>

@{
    ViewBag.Title = "Documents";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="container">

    <h2>Documents List</h2>

    <table class="table table-responsive table-hover">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DocPath)
            </th>
            <th>
                Update Here
            </th>
        </tr>

        @foreach (var item in Model)
        {
            using (Html.BeginForm("Updatedoc", "Admin", new { id = item.Id }))
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DocPath)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Updatedoc", new { id = item.Id }) 
                    </td>
                </tr>
            }
        }

    </table>
</div>
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title | Admin</title>


    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.4/jquery.min.js" type="text/javascript"></script>
    <script src="~/js/MyCustom.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#admin-nav a').each(function () {
                $(this).css('text-decoration', 'none');
            });
        });
    </script>

</head>
<body>
    
    <nav class="navbar navbar-default navbar-inverse" id="admin-nav">
        <div class="container-fluid">
            <!-- Brand and toggle get grouped for better mobile display -->
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="#">GarhwalBhawan</a>
            </div>

            <!-- Collect the nav links, forms, and other content for toggling -->
            <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
                <ul class="nav navbar-nav">
                    <li class="active"><a href="#">Link <span class="sr-only">(current)</span></a></li>
                    <li><a href="~/Admin/DocList">Document</a></li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Tables <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="~/Admin/AdView">Advertisement</a></li>
                            <li><a href="~/Admin/BannerView">Banner</a></li>
                            <li><a href="~/Admin/ContactView">Contact Us</a></li>
                            <li><a href="~/Admin/DisasterView">Disaster</a></li>
                            <li><a href="~/Admin/EkParichayView">Ek Parichay</a></li>
                            <li><a href="~/Admin/ImageView">Photo</a></li>
                            <li><a href="~/Admin/VideoView">Video</a></li>
                            <li><a href="~/Admin/ImpLinkView">Important Link</a></li>
                            <li><a href="~/Admin/MemberView">Member</a></li>
                            <li><a href="~/Admin/Samacharview">Samachar</a></li>
                            <li><a href="~/Admin/TeamView">Team</a></li>
                        </ul>
                    </li>
                </ul>
                @*<form class="navbar-form navbar-left" role="search">
                    <div class="form-group">
                        <input type="text" class="form-control" placeholder="Search">
                    </div>
                    <button type="submit" class="btn btn-default">Submit</button>
                </form>*@
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="~/Home/Index" target="_blank">View Site</a></li>
                    <li><a href="~/Admin/LogOut">Log Out</a></li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Dropdown <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="#">Action</a></li>
                            <li><a href="#">Another action</a></li>
                            <li><a href="#">Something else here</a></li>
                            <li role="separator" class="divider"></li>
                            <li><a href="#">Separated link</a></li>
                        </ul>
                    </li>
                </ul>
            </div><!-- /.navbar-collapse -->
        </div><!-- /.container-fluid -->
    </nav>

    <div id="body">
        @RenderSection("featured", required: false)
        @RenderBody()
    </div>

    <div class="footer footer-bottom text-center" data-wow-delay=".5s">
        <div class="container">
            <p> 
                <b>                    
                    &copy; 2014 - @DateTime.Now.Year गढ़वाल हितैषिणी सभा (पंजी.)
                </b>
            </p>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>

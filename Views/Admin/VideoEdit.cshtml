@model GarhwalBhawan.Models.VideoTbl

    <link href="@Url.Content("~/Content/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/Scripts/jquery-ui.min.js")" type="text/javascript"></script>

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>

    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)

        <fieldset>
            <legend></legend>

            <div class="editor-field">
                @Html.TextBoxFor(model => model.ID, new { disabled = "disabled", @readonly = "readonly" })
            </div>

            <div class="editor-label">
                Video Group
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.VideoGroup)
                @Html.ValidationMessageFor(model => model.VideoGroup)
            </div>

            <div class="editor-label">
                Year
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Year)
                @Html.ValidationMessageFor(model => model.Year)
            </div>

            <div class="editor-label">
                Description
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Description)
                @Html.ValidationMessageFor(model => model.Description)
            </div>

            <div class="editor-label">
                Video
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Video)
                @Html.ValidationMessageFor(model => model.Video)
            </div>

            <div class="editor-label">
                Alternative Description
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Alt)
                @Html.ValidationMessageFor(model => model.Alt)
            </div>

            <p>
                <input id="videoSave" type="button" value="Save Changes" />
            </p>
        </fieldset>
    }

    <script type="text/javascript">

        $(document).ready(function () {
            $('#videoSave').click(function () {
                var ID = $("#ID").val();
                var Video = $("#Video").val();
                var Alt = $("#Alt").val();
                var VideoGroup = $("#VideoGroup").val();
                var Year = $("#Year").val();
                var Description = $("#Description").val();

                var VidID = {
                    "ID": ID, "Video": Video, "Alt": Alt,
                    "VideoGroup": VideoGroup, "Year": Year, "Description": Description
                };
                $.post("/Admin/VideoEdit", VidID,
                function (data) {
                    if (data == "Success") {
                        alert('Saved Sucessfully!')
                    }
                    else if (data == "Failed") {
                        alert('Cannot Save!! Please Fill all Details or Contact Support')
                    }

                    else {
                        alert(data);
                    }
                }, 'json');

            });
        });
    </script>

    <div>
        <a href="videoView">Close</a>
    </div>
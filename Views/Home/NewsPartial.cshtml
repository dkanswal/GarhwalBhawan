@model GarhwalBhawan.Models.SamacharTbl

<link href="@Url.Content("~/Content/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
<script src="@Url.Content("~/Scripts/jquery-ui.min.js")" type="text/javascript"></script>


<fieldset class="text-center">
    <legend></legend>

    <div class="display-field heading">
        @Html.DisplayFor(model => model.Heading)
    </div>
    <br />
    <div class="display-field date">
        @string.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Html.DisplayFor(model => model.Date).ToString()))
    </div>
    <br /><br />

    <div class="display-field container">
        <img src="~/Image/News/@Model.Image" alt="@Model.Alt" class="img-thumbnail img-responsive" style="height:200px" />
    </div>
    <br /><br />
    <div class="display-field" style="text-align:justify">
        @Html.Raw(@Model.Description)
    </div>

</fieldset>
